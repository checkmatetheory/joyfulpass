# ---------------------------------------------------------------------------
# Analytics / attribution (shared by every app silo — see src/components/Analytics.tsx).
# These only load after the visitor accepts cookies in the consent banner.
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_TIKTOK_PIXEL_ID=

# ---------------------------------------------------------------------------
# Accounts — Supabase (magic-link sign-in + Postgres). Leave blank and the site
# shows "Web accounts are opening soon" instead of the sign-in form.
#  1. Create a project; run supabase/migrations/0001_init.sql in the SQL editor.
#  2. Auth → URL configuration: Site URL https://joyfulpass.com, and add
#     https://joyfulpass.com/auth/callback/ to the redirect allow-list.
#  3. Auth → SMTP: use Resend (below) so magic links aren't rate-limited.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only. Used by the Stripe webhook and lead capture. Never expose it.
SUPABASE_SECRET_KEY=

# ---------------------------------------------------------------------------
# Web checkout — Stripe. Leave blank and plan buttons show "opening soon".
#  1. Products: one per app. Prices with LOOKUP KEYS `{app}_{weekly|monthly|yearly}`
#     (e.g. britpass_yearly, serupass_monthly), recurring, with currency options
#     GBP (britpass, serupass), CAD (canadapass), EUR (germanpass).
#  2. Turn on Stripe Tax, the customer portal, and set a Terms of Service URL
#     (https://joyfulpass.com/terms/) in Settings → Public details.
#  3. Webhook endpoint — NOTE THE TRAILING SLASH (the site uses trailingSlash and
#     Stripe does not follow redirects): https://joyfulpass.com/api/stripe/webhook/
#     Events: checkout.session.completed, customer.subscription.created,
#     customer.subscription.updated, customer.subscription.deleted.
#  4. Set NEXT_PUBLIC_CHECKOUT_ENABLED=true once the above is live.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_CHECKOUT_ENABLED=

# ---------------------------------------------------------------------------
# Email capture — Resend (lead magnet emails + contact list).
RESEND_API_KEY=
RESEND_AUDIENCE_ID=
# A sender on a domain verified in Resend, e.g. "Joyful <hello@joyfulpass.com>"
EMAIL_FROM=
